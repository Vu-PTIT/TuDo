# Closet Loop — Backend Environment Example
APP_ENV=development
PORT=8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Supabase Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Worker Read-Only / Server Database URL (for REPEATABLE READ data exports & queue leasing)
WORKER_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Storage Buckets & TTLs
STORAGE_BUCKET_WARDROBE=wardrobe-media
STORAGE_BUCKET_EXPORTS=account-exports
SIGNED_UPLOAD_TTL_SECONDS=600
SIGNED_READ_TTL_SECONDS=300
DATA_EXPORT_TTL_HOURS=24

# Image & AI Limits
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PIXELS=25000000
IMAGE_MAX_DIMENSION=2048
IMAGE_THUMBNAIL_SIZE=400
IMAGE_CONCURRENCY_LIMIT=4
AI_PROVIDER=photoroom
AI_API_KEY=
AI_TIMEOUT_SECONDS=20
AI_DAILY_QUOTA_PER_USER=10

# Public Policy & Consent Versions
CURRENT_TERMS_VERSION=2026-11
CURRENT_PRIVACY_VERSION=2026-11
CURRENT_AI_POLICY_VERSION=2026-11-photoroom
CURRENT_ANALYTICS_POLICY_VERSION=2026-11
SUPPORT_DAILY_LIMIT_PER_USER=5

